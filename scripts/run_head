import os
import sys
import pandas as pd
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import torch
from src.config import SEED,head_ckpt,HEAD_BATCH_SIZE,HEAD_EPOCHS,HEAD_LR,HEAD_WD,SSL_CKPT,LABEL_PERCENT,SAVE_DIR
from src.data import DT, get_file_lists, make_loader
from src.models import Encoder, Linear_Layer
from src.train_head import train_head
from src.utils import get_device, load_checkpoint, save_checkpoint, set_seed
from src.metrics import metrics_dict_creator,metrics_display,reliability_plot

set_seed(SEED)
device=get_device()

_,linear_list,_,labels=get_file_lists()

encoder=load_checkpoint(Encoder(),SSL_CKPT,device)
history_dict={}
label_percentwise_metrics={}
for p in LABEL_PERCENT:
    print(f"========== SSL HEAD === {p}% labels =========")
    loader=make_loader(DT(linear_list,True,labels,p),HEAD_BATCH_SIZE)
    head=Linear_Layer().to(device)
    
    history,y_real,y_result=train_head(encoder,head,loader,device,p,HEAD_EPOCHS,HEAD_LR,HEAD_WD,True,SAVE_DIR)
    
    history_dict[p]=history
    metrics_display(y_real,y_result)
    label_percentwise_metrics[p]=metrics_dict_creator(y_real,y_result)
    reliability_plot(y_real,y_result,save_img=True,title=f"Reliability-curve_p{p}_train_data")


label_percentwise_metrics_df=pd.DataFrame(label_percentwise_metrics)


label_percentwise_metrics_df.to_csv(SAVE_DIR,"Encoder_Head_metrics.csv")

